# Flask session signing key. Generate a random value for every deployment.
FLASK_SECRET_KEY=replace-with-a-long-random-value

# Set to 1 only when the service is behind a trusted reverse proxy.
PUBLIC_MODE=0
FLASK_HTTPS=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0

# Required in PUBLIC_MODE for settings, API-key, dependency and local-scan admin APIs.
ADMIN_TOKEN=replace-with-a-separate-admin-token

# Request body limit in MB. Public mode defaults to 100 MB when omitted.
MAX_UPLOAD_MB=100
